# AEGIS OS v4.1 — API Keys
# cp .env.example .env

NVIDIA_NIM_API_KEY=your-nvidia-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here
GOOGLE_AI_API_KEY=your-google-key-here
GROQ_API_KEY=your-groq-key-here
OPENAI_API_KEY=your-openai-key-here
ORACLE_DB_URL=

# ─── Server auth (cargo run -- serve) ───
# Use long random values, e.g.: openssl rand -hex 32
# If none are set, a one-time admin token is generated and printed at startup.
AEGIS_ADMIN_TOKEN=
AEGIS_OPERATOR_TOKEN=
AEGIS_VIEWER_TOKEN=
AEGIS_AGENT_TOKEN=
# AEGIS_BIND=127.0.0.1
# AEGIS_TLS_CERT=certs/cert.pem
# AEGIS_TLS_KEY=certs/key.pem
# Local demos only — enables the public aegis-*-token values:
# AEGIS_DEMO_TOKENS=1
